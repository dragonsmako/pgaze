{
  "name": "pgaze",
  "version": "0.1.0",
  "description": "Terminal UI for browsing PostgreSQL databases",
  "license": "MIT",
  "author": "Rafael Rosenhof",
  "type": "module",
  "bin": {
    "pgaze": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc -p ."
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "keytar": "^7.9.0",
    "pg": "^8.11.5",
    "react": "^18.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/react": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
